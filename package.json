{
	"name": "nacha-validator-nc",
	"displayName": "NACHA Validator",
	"publisher": "NChenduSoftware",
	"description": "Powerful NACHA file validation for Visual Studio Code. Validate NACHA file structure and record lengths, with clear, descriptive error messages that help you quickly identify and fix invalid records.",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "nacha-validator-nc.helloWorld",
				"title": "NACHA Validator: Validate NACHA File"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "plaintext",
				"scopes": {
					"achRecordType": [
						"string"
					],
					"achFieldBlue": [
						"keyword"
					]
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "^1.137.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"typescript-eslint": "^8.61.1",
		"eslint": "^10.5.0",
		"typescript": "^6.0.3",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
